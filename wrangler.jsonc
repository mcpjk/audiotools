{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "audiotools",
  "compatibility_date": "2026-08-22",
  // Static-assets-only Worker: no server-side code, no "main" entry.
  // Everything in dist/ is served straight from Cloudflare's edge.
  // "directory" must match the Vite build output — see vite.config.js.
  "assets": {
    "directory": "./dist"
  },
  // NO routes and NO custom domain. The public site is macapeh.com, served
  // by the hub Worker "macapeh-site", which reaches this Worker through a
  // service binding and mounts its pages under /audio/design/. The old
  // hostname audiotools.kiiworkshop.com was retired on 2026-11-13 (no
  // redirect). Do not add a custom domain or route here: the hub owns the
  // public URLs.
  // workers.dev stays on: it isolates "did the build work" from "did the
  // hub work", and it is how to reach this Worker directly.
  "workers_dev": true
}
